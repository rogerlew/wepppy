+    def test_job_info_preserves_dependency_ids(self):
+        import math
+        q = Queue(connection=self.app.redis_conn)
+        parent = q.enqueue(math.sqrt, 4)
+        child = q.enqueue(math.sqrt, 9, depends_on=parent)
+        try:
+            response = self.client.get(f'/0/data/job/{child.id}.json')
+            self.assertEqual(response.status_code, HTTP_OK)
+            data = json.loads(response.data.decode('utf8'))
+            self.assertEqual(data['depends_on'], [parent.id])
+            self.assertEqual(data['depends_on_status'], ['active'])
+        finally:
+            child.delete()
+            parent.delete()
+
+    def test_empty_started_registry_removes_missing_job_execution(self):
+        import math
+        from rq.executions import Execution
+        q = Queue(connection=self.app.redis_conn)
+        job = q.create_job(math.sqrt, args=(4,))
+        job.save()
+        pipeline = self.app.redis_conn.pipeline()
+        execution = Execution.create(job, ttl=60, pipeline=pipeline)
+        pipeline.execute()
+        self.app.redis_conn.delete(job.key)
+        try:
+            response = self.client.post(f'/queue/{q.name}/started/empty')
+            self.assertEqual(response.status_code, HTTP_OK)
+            self.assertEqual(self.app.redis_conn.zcard(q.started_job_registry.key), 0)
+        finally:
+            execution.delete(job=job, pipeline=self.app.redis_conn)
+            self.app.redis_conn.delete(job.execution_registry.key)
+
