FROM rust:1.92.0-slim-trixie@sha256:bf3368a992915f128293ac76917ab6e561e4dda883273c8f5c9f6f8ea37a378e AS rust-builder

ARG DEBIAN_FRONTEND=noninteractive
ARG SHAPE_PARSER_SOURCE_REVISION=uncommitted-development
ARG SHAPE_PARSER_RELEASE_LABEL=development
ARG SHAPE_PARSER_BUILT_UTC=
ARG SHAPE_PARSER_REQUIRE_RELEASE_PROVENANCE=0
ARG DEBIAN_SNAPSHOT=20261114T120000Z

RUN sed -i \
        -e "s|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|g" \
        -e "s|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|g" \
        /etc/apt/sources.list.d/debian.sources && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends file python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src/shape_parser_cli
COPY wepppy/microservices/shape_converter/rust/shape_parser_cli/Cargo.toml ./Cargo.toml
COPY wepppy/microservices/shape_converter/rust/shape_parser_cli/Cargo.lock ./Cargo.lock
COPY wepppy/microservices/shape_converter/rust/shape_parser_cli/src ./src
COPY wepppy/microservices/shape_converter/rust/shape_parser_cli/tools ./tools

RUN if [ "${SHAPE_PARSER_REQUIRE_RELEASE_PROVENANCE}" = "1" ]; then \
        printf '%s' "${SHAPE_PARSER_SOURCE_REVISION}" | grep -Eq '^[a-f0-9]{40}$'; \
        [ "${SHAPE_PARSER_RELEASE_LABEL}" != "development" ]; \
        [ -n "${SHAPE_PARSER_BUILT_UTC}" ]; \
    fi && \
    cargo build --release --locked && \
    built_utc_arg="" && \
    if [ -n "${SHAPE_PARSER_BUILT_UTC}" ]; then \
        built_utc_arg="--built-utc=${SHAPE_PARSER_BUILT_UTC}"; \
    fi && \
    python3 tools/generate_provenance.py \
        --binary target/release/shape_parser_cli \
        --source-root . \
        --output target/release/shape_parser_cli.json \
        --source-revision "${SHAPE_PARSER_SOURCE_REVISION}" \
        --release-label "${SHAPE_PARSER_RELEASE_LABEL}" \
        ${built_utc_arg} && \
    python3 tools/validate_provenance.py \
        --binary target/release/shape_parser_cli \
        --sidecar target/release/shape_parser_cli.json

WORKDIR /src/geoparquet_parser_cli
COPY wepppy/microservices/shape_converter/rust/geoparquet_parser_cli/Cargo.toml ./Cargo.toml
COPY wepppy/microservices/shape_converter/rust/geoparquet_parser_cli/Cargo.lock ./Cargo.lock
COPY wepppy/microservices/shape_converter/rust/geoparquet_parser_cli/src ./src

RUN cargo build --release --locked && \
    built_utc_arg="" && \
    if [ -n "${SHAPE_PARSER_BUILT_UTC}" ]; then \
        built_utc_arg="--built-utc=${SHAPE_PARSER_BUILT_UTC}"; \
    fi && \
    python3 /src/shape_parser_cli/tools/generate_provenance.py \
        --binary target/release/geoparquet_parser_cli \
        --source-root . \
        --output target/release/geoparquet_parser_cli.json \
        --source-revision "${SHAPE_PARSER_SOURCE_REVISION}" \
        --release-label "${SHAPE_PARSER_RELEASE_LABEL}" \
        ${built_utc_arg} && \
    python3 /src/shape_parser_cli/tools/validate_provenance.py \
        --binary target/release/geoparquet_parser_cli \
        --sidecar target/release/geoparquet_parser_cli.json

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS python-builder

COPY docker/requirements-shape-converter.txt /tmp/requirements-runtime.txt

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --require-hashes \
        --requirement /tmp/requirements-runtime.txt && \
    /opt/venv/bin/pip uninstall --yes pip setuptools

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS runtime

ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_SNAPSHOT=20261114T120000Z

RUN sed -i \
        -e "s|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|g" \
        -e "s|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|g" \
        /etc/apt/sources.list.d/debian.sources && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends \
        zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 && \
    rm -rf /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 \
        /usr/local/lib/python3.12/site-packages/pip \
        /usr/local/lib/python3.12/site-packages/pip-*.dist-info && \
    rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.source="https://github.com/rogerlew/wepppy" \
      org.opencontainers.image.title="WEPPpy shape converter" \
      org.opencontainers.image.description="Minimal runtime for untrusted shapefile conversion" \
      org.opencontainers.image.base.name="python:3.12-slim" \
      org.opencontainers.image.base.digest="sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b" \
      org.wepppy.debian.snapshot="${DEBIAN_SNAPSHOT}"

RUN groupadd --gid 10001 shape-converter && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin shape-converter && \
    mkdir -p /opt/app && \
    chown 10001:10001 /opt/app

COPY --from=python-builder /opt/venv /opt/venv
COPY --from=rust-builder /src/shape_parser_cli/target/release/shape_parser_cli /usr/local/bin/shape_parser_cli
COPY --from=rust-builder /src/shape_parser_cli/target/release/shape_parser_cli.json /usr/local/bin/shape_parser_cli.json
COPY --from=rust-builder /src/geoparquet_parser_cli/target/release/geoparquet_parser_cli /usr/local/bin/geoparquet_parser_cli
COPY --from=rust-builder /src/geoparquet_parser_cli/target/release/geoparquet_parser_cli.json /usr/local/bin/geoparquet_parser_cli.json
COPY docs/work-packages/20261116_vector_upload_normalization/artifacts/red_fixtures/data-page-v2-control.parquet /usr/local/share/shape-converter/geoparquet-readiness.parquet
COPY --chown=10001:10001 wepppy/__init__.py /opt/app/wepppy/__init__.py
COPY --chown=10001:10001 wepppy/microservices/__init__.py /opt/app/wepppy/microservices/__init__.py
COPY --chown=10001:10001 wepppy/microservices/shape_converter/*.py /opt/app/wepppy/microservices/shape_converter/
COPY --chown=10001:10001 wepppy/microservices/shape_converter/ui /opt/app/wepppy/microservices/shape_converter/ui
COPY --chown=10001:10001 wepppy/observability /opt/app/wepppy/observability

RUN /opt/venv/bin/python -c \
        "import importlib.util; assert importlib.util.find_spec('fiona') is None; assert importlib.util.find_spec('pip') is None" && \
    /usr/local/bin/shape_parser_cli --version
RUN /usr/local/bin/geoparquet_parser_cli --version

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/app \
    SHAPE_CONVERTER_PARSER_CLI=/usr/local/bin/shape_parser_cli \
    SHAPE_CONVERTER_GEOPARQUET_PARSER_CLI=/usr/local/bin/geoparquet_parser_cli

WORKDIR /opt/app
USER 10001:10001
EXPOSE 8060

CMD ["uvicorn", "wepppy.microservices.shape_converter:app", "--host", "0.0.0.0", "--port", "8060", "--timeout-keep-alive", "5"]
