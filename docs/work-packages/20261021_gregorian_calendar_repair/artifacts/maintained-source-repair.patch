--- /dev/null
+++ b/fpm-src/wepp_calendar.f90
@@ -0,0 +1,95 @@
+! SPDX-License-Identifier: CC0-1.0
+! Contract-Spec: docs/contracts/execution-calendar-contract.md
+! Contributors: Roger Lew; Codex
+module wepp_calendar
+  implicit none (type, external)
+  private
+  public :: calendar_is_leap, calendar_year_days, calendar_month_days
+  public :: calendar_julian, calendar_require_date, calendar_require_key
+  public :: calendar_input_error, calendar_require_numeric_record
+  public :: calendar_read_pass_header
+contains
+  pure logical function calendar_is_leap(year) result(leap)
+    integer, intent(in) :: year
+    leap = mod(year, 4) == 0 .and. (mod(year, 100) /= 0 .or. mod(year, 400) == 0)
+  end function calendar_is_leap
+
+  pure integer function calendar_year_days(year) result(days)
+    integer, intent(in) :: year
+    days = 365
+    if (calendar_is_leap(year)) days = 366
+  end function calendar_year_days
+
+  pure integer function calendar_month_days(year, month) result(days)
+    integer, intent(in) :: year, month
+    integer, parameter :: lengths(12) = [31,28,31,30,31,30,31,31,30,31,30,31]
+    days = 0
+    if (month < 1 .or. month > 12) return
+    days = lengths(month)
+    if (month == 2 .and. calendar_is_leap(year)) days = 29
+  end function calendar_month_days
+
+  pure integer function calendar_julian(year, month, day) result(julian)
+    integer, intent(in) :: year, month, day
+    integer :: m
+    julian = 0
+    if (year < 1 .or. month < 1 .or. month > 12) return
+    if (day < 1 .or. day > calendar_month_days(year, month)) return
+    julian = day
+    do m = 1, month - 1
+      julian = julian + calendar_month_days(year, m)
+    end do
+  end function calendar_julian
+
+  subroutine calendar_require_date(unit, expected_year, expected_day, year, month, day)
+    integer, intent(in) :: unit, expected_year, expected_day, year, month, day
+    integer :: julian
+    julian = calendar_julian(year, month, day)
+    if (julian == 0) call calendar_input_error(unit, 'invalid calendar date')
+    call calendar_require_key(unit, expected_year, expected_day, year, julian)
+  end subroutine calendar_require_date
+
+  subroutine calendar_require_key(unit, expected_year, expected_day, year, day)
+    integer, intent(in) :: unit, expected_year, expected_day, year, day
+    if (expected_year == year .and. expected_day == day) return
+    write (*, '(A,2(1X,I0),A,2(1X,I0))') 'Calendar expected year/day:', &
+      expected_year, expected_day, '; received:', year, day
+    call calendar_input_error(unit, 'date mismatch; regenerate climate/PASS with matching Gregorian binaries')
+  end subroutine calendar_require_key
+
+  subroutine calendar_read_pass_header(unit, event, expected_year, expected_day, continuous)
+    integer, intent(in) :: unit, expected_year, expected_day
+    character(len=8), intent(out) :: event
+    logical, intent(in) :: continuous
+    integer :: year, day, ios
+    ! Shared ASCII hillslope/master header format; payload stays with its owner.
+    read(unit, '(a8,2x,2(i5,1x))', iostat=ios) event, year, day
+    if (ios /= 0) call calendar_input_error(unit, 'incomplete PASS daily header')
+    if (event /= 'EVENT   ' .and. event /= 'SUBEVENT' .and. event /= 'NO EVENT') then
+      call calendar_input_error(unit, 'unknown PASS event kind')
+    end if
+    if (continuous) call calendar_require_key(unit, expected_year, expected_day, year, day)
+  end subroutine calendar_read_pass_header
+
+  subroutine calendar_require_numeric_record(unit, line)
+    integer, intent(in) :: unit
+    character(len=*), intent(in) :: line
+    ! CLIGEN daily records are whitespace-separated numeric fields. List-directed
+    ! null/repeat/termination syntax can succeed without assigning every field.
+    if (scan(line, ',/*!') /= 0) then
+      call calendar_input_error(unit, 'expected complete whitespace-separated numeric climate record')
+    end if
+  end subroutine calendar_require_numeric_record
+
+  subroutine calendar_input_error(unit, message)
+    integer, intent(in) :: unit
+    character(len=*), intent(in) :: message
+    character(len=1024) :: path
+    integer :: ios
+    path = '<unknown>'
+    inquire(unit=unit, name=path, iostat=ios)
+    if (ios /= 0) path = '<unknown>'
+    write (*, '(A)') 'Calendar input error: '//trim(message)//' ['//trim(path)//']'
+    stop 1
+  end subroutine calendar_input_error
+end module wepp_calendar
