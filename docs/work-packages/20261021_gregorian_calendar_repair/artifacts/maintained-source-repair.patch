+++ b/tests/test_execution_calendar.py
@@ -0,0 +1,220 @@
+"""Exercise the real climate reader with native Gregorian/EOF boundaries."""
+from datetime import date, timedelta
+from pathlib import Path
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+DRIVER = """      program climate_reader_test
+      use wepp_calendar
+      include 'pmxelm.inc'
+      include 'pmxhil.inc'
+      include 'pmxpln.inc'
+      include 'pmxtls.inc'
+      include 'pmxtil.inc'
+      include 'cclig.inc'
+      include 'cclim.inc'
+      include 'cdiss1.inc'
+      include 'cdiss3.inc'
+      include 'chydrol.inc'
+      include 'cstmflg.inc'
+      include 'cupdate.inc'
+      include 'cstmgt.inc'
+      include 'ccliyr.inc'
+      include 'cstruc.inc'
+      integer count, requested, yr
+      real intensity
+      double precision total
+      character*64 arg
+      call get_command_argument(1,arg)
+      read(arg,*) ibyear
+      call get_command_argument(2,arg)
+      read(arg,*) requested
+      call get_command_argument(3,arg)
+      read(arg,*) ibrkpt
+      call get_command_argument(4,arg)
+      read(arg,*) imodel
+      nplane=1
+      iclig=4
+      jyear=1
+      sdate=0
+      yr=ibyear
+      total=0.0d0
+      open(13,file='weather.dat',status='old')
+      do count=1,requested
+        sdate=sdate+1
+        if(sdate.gt.calendar_year_days(yr)) then
+          sdate=1
+          jyear=jyear+1
+          yr=yr+1
+        endif
+        call stmget(intensity)
+        total=total+dble(prcp)
+      enddo
+      write(*,*) 'COMPLETE',requested,year,mon,day,total
+      end
+"""
+# Only post-reader physics/telemetry is stubbed; stmget and calendar are unmodified.
+STUBS = """subroutine sumrnf
+end subroutine
+subroutine brkpt(n, intensity)
+  integer :: n
+  real :: intensity
+  stop 91
+end subroutine
+subroutine wepp_observe(tag,y,d,e,c,s,a,b)
+  character(len=*) :: tag
+  integer :: y,d,e,c,s
+  real :: a,b
+end subroutine
+"""
+
+@pytest.fixture(scope="module")
+def reader(tmp_path_factory):
+    build = tmp_path_factory.mktemp("climate_reader")
+    (build / "driver.for").write_text(DRIVER)
+    (build / "stubs.f90").write_text(STUBS)
+    result = subprocess.run(
+        ["/usr/bin/gfortran", "-O0", "-fcheck=all", "-fno-align-commons", "-finit-local-zero",
+         "-I", str(ROOT / "src"), str(ROOT / "fpm-src/wepp_calendar.f90"),
+         str(ROOT / "src/stmget.for"), str(build / "driver.for"),
+         str(build / "stubs.f90"), "-o", str(build / "reader")],
+        cwd=build, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    return build / "reader"
+
+
+def daily_lines(first_year, count, breakpoint=False):
+    start = date(first_year, 1, 1)
+    out = []
+    for i in range(count):
+        day = start + timedelta(days=i)
+        weather = "0 10 1 100 1 1 0" if breakpoint else "1 1 0.5 1 10 1 100 1 1 0"
+        out.append(f"{day.day} {day.month} {day.year} {weather}\n")
+    return out
+
+
+def run_reader(reader, tmp_path, lines, count, year=1, breakpoint=False, continuous=True):
+    (tmp_path / "weather.dat").write_text("".join(lines))
+    return subprocess.run([str(reader), str(year), str(count), str(int(breakpoint)),
+                           "1" if continuous else "2"], cwd=tmp_path,
+                          capture_output=True, text=True, timeout=30)
+
+
+@pytest.mark.parametrize("year,years", [(1,400),(99,3),(199,3),(299,3),(399,3),(1899,3),(1999,3)])
+def test_century_climate_is_consumed_exactly(reader, tmp_path, year, years):
+    count = (date(year+years,1,1)-date(year,1,1)).days
+    result = run_reader(reader,tmp_path,daily_lines(year,count),count,year)
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert "COMPLETE" in result.stdout
+    fields = result.stdout.split()
+    assert list(map(int, fields[1:5])) == [count,year+years-1,12,31]
+    assert float(fields[5]) == pytest.approx(count * .001, rel=1e-6)
+
+
+@pytest.mark.parametrize("count", range(1,21))
+def test_partial_final_buffer_has_only_complete_records(reader, tmp_path, count):
+    lines = daily_lines(1,count)
+    complete = run_reader(reader,tmp_path,lines,count)
+    assert complete.returncode == 0, complete.stdout + complete.stderr
+    short = run_reader(reader,tmp_path,lines,count+1)
+    assert short.returncode != 0
+    assert "premature climate EOF" in short.stdout
+    assert "weather.dat" in short.stdout
+
+
+@pytest.mark.parametrize("kind", ["duplicate","missing","invalid_month","invalid_day","invalid_leap","incomplete","malformed","slash","null","repeat_null","comment"])
+def test_bad_daily_records_fail_before_consumption(reader, tmp_path, kind):
+    lines = daily_lines(100,70)
+    if kind == "duplicate": lines[1] = lines[0]
+    elif kind == "missing": del lines[1]
+    elif kind == "invalid_month": lines[1] = lines[1].replace("2 1 100", "2 13 100")
+    elif kind == "invalid_day": lines[1] = lines[1].replace("2 1 100", "32 1 100")
+    elif kind == "invalid_leap": lines[59] = lines[59].replace("1 3 100", "29 2 100")
+    elif kind == "incomplete": lines[1] = "2 1 100 1\n"
+    elif kind == "slash": lines[10] = "11 1 100 /\n"
+    elif kind == "null": lines[10] = "11 1 100 ,, 0.5 1 10 1 100 1 1 0\n"
+    elif kind == "repeat_null": lines[10] = "11 1 100 10*\n"
+    elif kind == "comment": lines[10] = "11 1 100 ! weather missing\n"
+    else: lines[1] = "not weather\n"
+    result = run_reader(reader,tmp_path,lines,70,100)
+    assert result.returncode != 0
+    assert "Calendar input error:" in result.stdout
+    assert "COMPLETE" not in result.stdout
+
+
+@pytest.mark.parametrize("bad", [False,True])
+def test_breakpoint_calendar_and_eof(reader,tmp_path,bad):
+    lines=daily_lines(100,60,breakpoint=True)
+    if bad: lines[-1] = lines[-1].replace("1 3 100", "29 2 100")
+    result=run_reader(reader,tmp_path,lines,60,100,breakpoint=True)
+    assert (result.returncode != 0) == bad
+    if not bad:
+        result=run_reader(reader,tmp_path,lines,61,100,breakpoint=True)
+        assert "missing breakpoint climate header" in result.stdout
+
+
+def test_single_storm_does_not_require_january_first(reader,tmp_path):
+    lines=["15 7 2000 1 1 0.5 1 10 1 100 1 1 0\n"]
+    result=run_reader(reader,tmp_path,lines,1,continuous=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+def test_breakpoint_slash_cannot_reuse_weather(reader,tmp_path):
+    lines=daily_lines(100,2,breakpoint=True)
+    lines[1]="2 1 100 /\n"
+    result=run_reader(reader,tmp_path,lines,2,100,breakpoint=True)
+    assert result.returncode != 0
+    assert "complete whitespace-separated numeric" in result.stdout
+
+
+@pytest.fixture(scope="module")
+def pass_reader(tmp_path_factory):
+    build = tmp_path_factory.mktemp("pass_reader")
+    (build / "driver.f90").write_text('''program pass_reader
+use wepp_calendar
+implicit none
+integer :: year, day
+character(len=32) :: arg
+character(len=8) :: event
+call get_command_argument(1,arg)
+read(arg,*) year
+call get_command_argument(2,arg)
+read(arg,*) day
+open(49,file='header.dat',status='old')
+call calendar_read_pass_header(49,event,year,day,.true.)
+print *, 'COMPLETE ',event
+end program
+''')
+    subprocess.run(["/usr/bin/gfortran", "-fcheck=all", str(ROOT / "fpm-src/wepp_calendar.f90"),
+                    "driver.f90", "-o", "reader"], cwd=build, check=True, capture_output=True)
+    return build / "reader"
+
+
+@pytest.mark.parametrize("kind", ["EVENT   ", "SUBEVENT", "NO EVENT"])
+@pytest.mark.parametrize("year,day", [(1,1), (100,365), (200,365), (1900,365), (2000,366)])
+def test_ascii_daily_header(pass_reader, tmp_path, kind, year, day):
+    (tmp_path / "header.dat").write_text(f"{kind}  {year:5d} {day:5d} \n")
+    good = subprocess.run([str(pass_reader), str(year), str(day)], cwd=tmp_path, capture_output=True, text=True)
+    assert good.returncode == 0, good.stdout + good.stderr
+    bad = subprocess.run([str(pass_reader), str(year+1), str(day)], cwd=tmp_path, capture_output=True, text=True)
+    assert bad.returncode != 0
+    assert "date mismatch" in bad.stdout
+
+
+@pytest.mark.parametrize("line", ["", "EVENT     abcde     1\n", "UNKNOWN       1     1\n"])
+def test_invalid_ascii_header(pass_reader, tmp_path, line):
+    (tmp_path / "header.dat").write_text(line)
+    result = subprocess.run([str(pass_reader), "1", "1"], cwd=tmp_path, capture_output=True, text=True)
+    assert result.returncode != 0
+    assert "Calendar input error" in result.stdout
+
+
+def test_calendar_compatibility_preimage():
+    import hashlib
+    canonical = (ROOT / "docs/contracts/hbp-gregorian-compatibility.txt").read_bytes()
+    digest = hashlib.sha256(canonical).hexdigest()
+    assert digest in (ROOT / "fpm-src/hillslope_binary_pass_writer.f90").read_text()
