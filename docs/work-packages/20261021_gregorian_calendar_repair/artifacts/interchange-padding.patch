+            assert_eq!(out.year.len(), days);
+            assert_eq!(out.julian[days - 1] as usize, days);
+            assert!(out.year.iter().all(|y| *y == year as i16));
+        }
+        for year in [100, 2001] {
+            let fixture =
+                build_schema2_calendar_fixture(year, "wepp-gregorian-legacy-centurial-v1");
