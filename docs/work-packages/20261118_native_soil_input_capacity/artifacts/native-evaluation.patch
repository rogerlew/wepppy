+"""Execute the real soil reader with bounds checks and inspect calculated state.
+
+No soil physics is substituted: input, profil, eatcom, irinpt and rap_state are
+compiled directly. The driver supplies zero management scenarios and a slope.
+"""
+from pathlib import Path
+import re
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@pytest.fixture(scope='session')
+def reader(tmp_path_factory):
+    src = ROOT / 'src'
+    build = tmp_path_factory.mktemp('soil-reader')
+    source = (src / 'input.for').read_text()
+    includes = re.findall(r"^      include '([^']+)'", source, re.M)
+    driver = ['      program probe']
+    driver += [f"      include '{name}'" for name in includes]
+    driver += ['      integer ii,jj,nofe',
+               "      open(11,file='soil.txt',status='old')",
+               '      read(11,*) solwpv,nofe',
+               '      imodel=1', '      ivers=1', '      ui_run=1',
+               "      open(10,file='slope.txt',status='old')",
+               "      open(31,file='reader.log',status='replace')",
+               '      call input(0,nofe,0,0)',
+               '      do ii=1,nofe',
+               "      write(*,*) 'OFE',ii,nslorg(ii),kslast(ii)",
+               '      do jj=1,nslorg(ii)',
+               "      write(*,*) 'LAYER',ii,jj,solth1(jj,ii),",
+               '     1 ssc1(jj,ii),bd1(jj,ii),thetf1(jj,ii),',
+               '     1 thetd1(jj,ii),sand1(jj,ii),clay1(jj,ii),',
+               '     1 ui_ssh1(jj,ii)',
+               '      enddo', '      enddo', '      end']
+    (build/'driver.for').write_text('\n'.join(driver)+'\n')
+    flags = ['-O0','-g','-fcheck=all','-fbacktrace','-fno-align-commons',
+             '-mcmodel=medium','-finit-local-zero','-ffpe-trap=invalid,zero,overflow',
+             '-I'+str(src), '-I'+str(build), '-J'+str(build)]
+    compiler = '/usr/bin/gfortran'
+    subprocess.run([compiler,*flags,'-c',str(src/'rap_state.f90')],cwd=build,check=True,capture_output=True)
+    inputs = [build/'driver.for',src/'input.for',src/'profil.for',src/'eatcom.for',src/'irinpt.for']
+    subprocess.run([compiler,*flags,'-ffixed-line-length-72','-no-pie',
+                    *(str(p) for p in inputs),str(build/'rap_state.o'),'-o',str(build/'reader')],
+                   cwd=build,check=True,capture_output=True)
+    return build/'reader'
+
+
+def soil_body(depths, version=7778, conductivity=None):
+    lines=[]
+    if version in (9001,9002): lines.append("0 'forest' 'sand loam' 1.0 0.3")
+    if version==9003: lines.append("0 'forest' 300 'sand loam' -9999")
+    if version==9005: lines.append("0 'forest' 300 'sand loam' 3 100 -9999")
+    lines.append(f"'test' 'loam' {len(depths)} 0.2 0.75 400000 0.00008 2" + (' 10' if 941<=version<7777 else ''))
+    for i,depth in enumerate(depths):
+        k=36 if conductivity is None else conductivity[i]
+        if version>=7777:
+            props=f'1.3 {k} '+('2 ' if version>=7778 else '')+'0.3 0.1 40 20 2 15 5'
+        else:props='40 20 2 15 5'
+        if version>9001:props+=' 0.05 0.45 0.01 1.5 20 0.1 0.3'
+        lines.append(f'{depth} {props}')
+    if version>=2006:lines.append('1 10000 0.01')
+    return '\n'.join(lines)+'\n'
+
+
+def execute(reader, tmp_path, bodies, version=7778):
+    tmp_path.mkdir(parents=True,exist_ok=True)
+    (tmp_path/'soil.txt').write_text(f'{version} {len(bodies)}\n'+''.join(bodies))
+    (tmp_path/'slope.txt').write_text('180 1\n'+('2 100\n0 0.1 1 0.1\n'*len(bodies)))
+    result=subprocess.run([str(reader)],cwd=tmp_path,text=True,capture_output=True,timeout=15)
+    layers=[[float(x) for x in line.split()[3:]] for line in result.stdout.splitlines() if line.strip().startswith('LAYER')]
+    ofes=[line for line in result.stdout.splitlines() if line.strip().startswith('OFE')]
+    return result,layers,ofes
+
+
+@pytest.mark.parametrize('version',[7777,7778,9001,9002,9003,9005,2006,984])
+@pytest.mark.parametrize('count',[9,10,11])
+def test_capacity_and_multiple_ofe_cursor(reader,tmp_path,version,count):
+    depths=[200]+[200+1400*i/(count-1) for i in range(1,count)]
+    result,layers,ofes=execute(reader,tmp_path,[soil_body(depths,version)]*2,version)
+    assert result.returncode==0,result.stdout+result.stderr
+    assert len(ofes)==2
+    assert len(layers)==18
+    assert [l[0] for l in layers[:9]]==pytest.approx([i/5 for i in range(1,10)],abs=2e-7)
+    assert layers[:9]==layers[9:]
+    if version>=2006:
+        assert float(ofes[0].split()[-1])==pytest.approx(.01/3.6e6,rel=2e-7)
+
+
+def test_eleventh_material_is_used(reader,tmp_path):
+    depths=[200,300,400,500,600,700,800,900,1000,1100,1600]
+    result,layers,_=execute(reader,tmp_path,[soil_body(depths,conductivity=[36]*10+[3.6])])
+    assert result.returncode==0,result.stdout+result.stderr
+    assert len(layers)==9
+    assert layers[5][1]*3.6e6==pytest.approx(200/(100/36+100/3.6),rel=2e-6)
+    assert layers[-1][1]*3.6e6==pytest.approx(3.6,rel=2e-6)
+    assert layers[-1][2:7]==pytest.approx([1300,.3,.1,.4,.2],rel=2e-6)
+    assert layers[-1][7]*3.6e6==pytest.approx(7.2,rel=2e-6)
+
+
+@pytest.mark.parametrize('count',[0,12,100])
+def test_unsupported_count_fails_explicitly(reader,tmp_path,count):
+    body=f"'bad' 'loam' {count} 0.2 0.75 400000 0.00008 2\n"
+    result,_,_=execute(reader,tmp_path,[body])
+    assert result.returncode!=0
+    assert 'SOIL INPUT HORIZON COUNT INVALID' in result.stdout
+
+
+def test_equivalent_subdivision_and_depth_clipping(reader,tmp_path):
+    variants=[[200,1600],[200,300,400,500,600,700,800,900,1000,1100,1600],
+              [200,300,400,500,600,700,800,900,1800,2260,3000]]
+    states=[]
+    for i,depths in enumerate(variants):
+        result,layers,_=execute(reader,tmp_path/str(i),[soil_body(depths)])
+        assert result.returncode==0,result.stdout+result.stderr
+        states.append(layers)
+    for layers in states[1:]:
+        assert len(layers)==len(states[0])
+        for actual,expected in zip(layers,states[0]):
+            assert actual==pytest.approx(expected,rel=2e-6,abs=1e-12)
+
+
+@pytest.mark.parametrize('depths',[[100],[200],[100,200],[80,150,200,300,560,690,890,1170,1900,2260,3000]])
+def test_shallow_and_zepol_topology(reader,tmp_path,depths):
+    result,layers,_=execute(reader,tmp_path,[soil_body(depths)])
+    assert result.returncode==0,result.stdout+result.stderr
+    assert layers
+    assert layers[-1][0]<=1.800001
+
+
+def test_heterogeneous_eleven_horizon_aggregation(reader, tmp_path):
+    depths = [200, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1600]
+    rows = []
+    source = []
+    top = 0.0
+    for i, bottom in enumerate(depths):
+        bd, k, anis = 1.1 + .01*i, 36/(i+1), 1 + i
+        fc, wp, sand, clay = .25 + .002*i, .10 + .001*i, 40-i, 20+i
+        rows.append(f'{bottom} {bd} {k} {anis} {fc} {wp} {sand} {clay} 2 15 5')
+        source.append((top, bottom if i<10 else 1800, bd, k, anis, fc, wp, sand, clay))
+        top = bottom
+    body = "'test' 'loam' 11 0.2 0.75 400000 0.00008 2\n" + '\n'.join(rows) + '\n1 10000 .01\n'
+    result, layers, _ = execute(reader, tmp_path, [body])
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert len(layers) == 9
+    for i, actual in enumerate(layers):
+        lo, hi = 200*i, 200*(i+1)
+        overlaps = [(max(0, min(hi, row[1])-max(lo, row[0])), row) for row in source]
+        overlaps = [(d, row) for d, row in overlaps if d]
+        def weighted(index):
+            return sum(d*row[index] for d, row in overlaps)/200
+        vertical = 200 / sum(d/row[3] for d, row in overlaps)
+        horizontal = sum(d*row[3]*row[4] for d, row in overlaps)/200
+        expected = [hi/1000, vertical/3.6e6, weighted(2)*1000,
+                    weighted(5), weighted(6), weighted(7)/100,
+                    weighted(8)/100, horizontal/3.6e6]
+        assert actual == pytest.approx(expected, rel=3e-6, abs=1e-12)
+
+
+@pytest.mark.parametrize('version', [7778, 9002])
+@pytest.mark.parametrize('counts', [(11, 2), (2, 11), (11, 10)])
+def test_mixed_ofe_counts_match_isolated_readers(reader, tmp_path, version, counts):
+    bodies = []
+    isolated = []
+    for index, count in enumerate(counts):
+        depths = [200 + 1400*i/(count-1) for i in range(count)]
+        body = soil_body(depths, version, [3.6*(index+1)]*count)
+        bodies.append(body)
+        result, layers, _ = execute(reader, tmp_path/f'isolated-{index}', [body], version)
+        assert result.returncode == 0, result.stdout + result.stderr
+        isolated.extend(layers)
+    result, layers, ofes = execute(reader, tmp_path/'combined', bodies, version)
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert len(ofes) == 2
+    assert layers == isolated
