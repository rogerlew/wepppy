+#!/usr/bin/env python3
+"""Exercise eleven horizons on every OFE of the committed 16-year MOFE case."""
+import argparse
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+
+from evaluate_soil_input_capacity import ROOT, digest
+
+
+def subdivide(text):
+    lines=[s for s in text.splitlines() if s.strip() and not s.startswith('#')]
+    assert lines[0]=='9002' and lines[2]=='3 0'
+    cursor=3;out=lines[:3]
+    for _ in range(3):
+        metadata,header=lines[cursor:cursor+2];cursor+=2
+        tokens=list(re.finditer(r"'[^']*'|\S+",header));token=tokens[2]
+        count=int(token.group());horizons=lines[cursor:cursor+count];cursor+=count
+        bottom=float(horizons[-1].split()[0]);top=float(horizons[-2].split()[0])
+        material=horizons[-1].split()[1:];pieces=12-count
+        horizons=horizons[:-1]+[' '.join([str(top+(bottom-top)*i/pieces),*material]) for i in range(1,pieces+1)]
+        assert len(horizons)==11
+        out.extend([metadata,header[:token.start()]+'11'+header[token.end():],*horizons,lines[cursor]])
+        cursor+=1
+    assert cursor==len(lines)
+    return '\n'.join(out)+'\n'
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument('--baseline',type=Path,required=True)
+    p.add_argument('--candidate',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    args=p.parse_args();args.output.mkdir(parents=True,exist_ok=False)
+    fixture=ROOT/'tests/fixtures/mofe_coefficient_ownership/default'
+    report={}
+    for case in ('original','eleven'):
+        report[case]={}
+        for label,binary in [('baseline',args.baseline),('candidate',args.candidate)]:
+            folder=args.output/case/label;runs=folder/'runs';output=folder/'output'
+            shutil.copytree(fixture,runs);output.mkdir()
+            if case=='eleven':(runs/'p11.sol').write_text(subdivide((runs/'p11.sol').read_text()))
+            with (runs/'p11.run').open() as inp,(folder/'stdout').open('w') as out,(folder/'stderr').open('w') as err:
+                r=subprocess.run([str(binary.resolve())],cwd=runs,stdin=inp,stdout=out,stderr=err,timeout=120)
+            stdout=(folder/'stdout').read_text()
+            success=r.returncode==0 and 'WEPP COMPLETED HILLSLOPE SIMULATION SUCCESSFULLY' in stdout and bool(re.search(r'SIMULATION YEAR\s*=\s*16\b',stdout))
+            report[case][label]={'success':success,'returncode':r.returncode,'sha256':{p.name:digest(p) for p in sorted(output.iterdir()) if p.is_file()}}
+        report[case]['identical']=report[case]['baseline']['sha256']==report[case]['candidate']['sha256']
+    (args.output/'report.json').write_text(json.dumps(report,indent=2)+'\n')
+    print({case:{'success':all(r[label]['success'] for label in ('baseline','candidate')),'identical':r['identical']} for case,r in report.items()})
+    assert all(r[label]['success'] for r in report.values() for label in ('baseline','candidate'))
+    assert report['original']['identical']
+
+
+if __name__=='__main__':main()
