+#!/usr/bin/env python3
+"""Run complete portable watershed controls with fresh paired hillslope passes."""
+import argparse
+import json
+import math
+from pathlib import Path
+import re
+import subprocess
+
+from evaluate_soil_input_capacity import digest, probe
+from physical_water_case import prepare
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument('--evidence',type=Path,required=True,help='Contains baseline/ and candidate/ binary pairs')
+    p.add_argument('--output',type=Path,required=True)
+    args=p.parse_args();args.output.mkdir(parents=True,exist_ok=False)
+    report={}
+    for case,layout in [('original_single','single'),('original_three','three'),('eleven','single')]:
+        for mode in ('daily','hourly'):
+            name=f'{case}_{mode}';report[name]={}
+            for label in ('baseline','candidate'):
+                directory=args.output/name/label
+                runs=prepare(directory,layout,mode,years=2)
+                if case=='eleven':
+                    depths=[200,300,400,500,600,700,800,900,1000,1100,1600]
+                    text='7778\nEvaluation\n1 1\n'+probe.soil_body(depths,conductivity=[3.6]*10+[.36])
+                    for filename in ('p1.sol','pw0.sol'):(runs/filename).write_text(text)
+                steps={}
+                for filename,binary_name,role in [('p1.run','wepp_hill','HILLSLOPE'),('pw0.run','wepp','WATERSHED')]:
+                    with (runs/filename).open() as inp,(directory/f'{filename}.stdout').open('w') as out,(directory/f'{filename}.stderr').open('w') as err:
+                        result=subprocess.run([str((args.evidence/label/binary_name).resolve())],cwd=runs,stdin=inp,stdout=out,stderr=err,timeout=120)
+                    stdout=(directory/f'{filename}.stdout').read_text()
+                    years=[int(value) for value in re.findall(r'SIMULATION YEAR\s*=\s*(\d+)',stdout)]
+                    success=result.returncode==0 and f'WEPP COMPLETED {role} SIMULATION SUCCESSFULLY' in stdout and max(years,default=0)==2
+                    steps[role]={'success':success,'returncode':result.returncode,'last_year':max(years,default=0)}
+                    if not success:
+                        print(name,label,role,'FAILED',str(directory),flush=True)
+                        break
+                rows=[line.split() for line in (directory/'output'/'chnwb.txt').read_text().splitlines() if re.match(r'^\s+1\s+\d+\s+198[01]\s',line)]
+                assert len(rows)==731,(name,label,len(rows))
+                assert all(math.isfinite(float(value)) for row in rows for value in row),(name,label)
+                artifacts={p.name:digest(p) for p in sorted((directory/'output').iterdir()) if p.is_file()}
+                report[name][label]={'steps':steps,'channel_daily_rows':len(rows),'channel_final_date':rows[-1][1:3],'artifacts':artifacts}
+            report[name]['identical']=report[name]['baseline']['artifacts']==report[name]['candidate']['artifacts']
+            print(name,report[name]['identical'],flush=True)
+    (args.output/'report.json').write_text(json.dumps(report,indent=2)+'\n')
+    for name,case in report.items():
+        for label in ('baseline','candidate'):
+            assert set(case[label]['steps'])=={'HILLSLOPE','WATERSHED'}
+            assert all(step['success'] for step in case[label]['steps'].values()), (name,label)
+        if name.startswith('original'):assert case['identical'],name
+
+
+if __name__=='__main__':main()
