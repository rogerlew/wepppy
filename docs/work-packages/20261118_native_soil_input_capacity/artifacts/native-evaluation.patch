+#!/usr/bin/env python3
+"""Compare generated native reader state on old-capacity heterogeneous inputs."""
+import argparse
+import json
+from pathlib import Path
+from evaluate_soil_input_capacity import probe
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument('--baseline',type=Path,required=True)
+    p.add_argument('--candidate',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    args=p.parse_args();args.output.mkdir(parents=True,exist_ok=False)
+    results=[]
+    for version in [7777,7778,9001,9002,9003,9005,2006,984]:
+        for count in range(1,11):
+            depths=[1600] if count==1 else [200+1400*i/(count-1) for i in range(count)]
+            body=probe.soil_body(depths,version,[36/(i+1) for i in range(count)])
+            values=[]
+            for label,binary in [('baseline',args.baseline),('candidate',args.candidate)]:
+                run,layers,ofes=probe.execute(binary.resolve(),args.output/f'{version}-{count}'/label,[body,body],version)
+                if run.returncode:raise RuntimeError(run.stdout+run.stderr)
+                values.append({'layers':layers,'ofes':ofes})
+            results.append({'version':version,'count':count,'exact_state_match':values[0]==values[1]})
+    (args.output/'report.json').write_text(json.dumps(results,indent=2)+'\n')
+    print(f'{sum(r["exact_state_match"] for r in results)}/{len(results)} exact state matches')
+    if not all(r['exact_state_match'] for r in results):raise SystemExit(1)
+
+
+if __name__=='__main__':main()
