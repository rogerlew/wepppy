+#!/usr/bin/env python3
+"""Compare isolated baseline/candidate native runs; never edits fixture inputs.
+
+Run with the repository test environment (pytest supplies the shared probe
+fixture generators). Output directories must not exist, preserving evidence.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import importlib.util
+import json
+import re
+from pathlib import Path
+import shutil
+import subprocess
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('capacity_probe', ROOT/'tests/test_native_soil_input_capacity.py')
+probe = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(probe)
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def normalize_zepol(path):
+    """Evaluation-only exact-material 200 mm split; production limit unchanged."""
+    lines=[line for line in path.read_text().splitlines() if line.strip() and not line.startswith('#')]
+    assert lines[0]=='7778' and lines[2]=='1 0'
+    assert '\t10\t' in lines[3]
+    lines[3]=lines[3].replace('\t10\t','\t11\t',1)
+    crossing=next(i for i in range(4,len(lines)-1) if float(lines[i].split()[0])>200)
+    assert float(lines[crossing-1].split()[0])<200
+    fields=lines[crossing].split(); fields[0]='200.000'
+    lines.insert(crossing,' '.join(fields))
+    return '\n'.join(lines)+'\n'
+
+
+def run(binary, directory, soil):
+    fixture=ROOT/'tests/fixtures/delicate_game_pw0/runs'
+    runs=directory/'runs'; output=directory/'output'
+    runs.mkdir(parents=True); output.mkdir()
+    for name in ['p1.run','p1.man','p1.slp','p1.cli','p1.sol','chan.inp','chntyp.txt','gwcoeff.txt','pmetpara.txt','snow.txt','wepp_ui.txt']:
+        shutil.copy2(fixture/name,runs/name)
+    if soil is not None:(runs/'p1.sol').write_text(soil)
+    started=time.monotonic()
+    with (runs/'p1.run').open() as stdin, (directory/'stdout.log').open('w') as stdout, (directory/'stderr.log').open('w') as stderr:
+        result=subprocess.run([str(binary)],cwd=runs,stdin=stdin,stdout=stdout,stderr=stderr,timeout=120)
+    elapsed=time.monotonic()-started
+    stdout=(directory/'stdout.log').read_text()
+    success=result.returncode==0 and 'WEPP COMPLETED HILLSLOPE SIMULATION SUCCESSFULLY' in stdout and re.search(r'SIMULATION YEAR\s*=\s*3\b', stdout) is not None
+    artifacts={p.name: {'sha256':digest(p),'bytes':p.stat().st_size} for p in sorted(output.iterdir()) if p.is_file()}
+    return {'success':success,'returncode':result.returncode,'seconds':elapsed,'artifacts':artifacts,'input_sha256':digest(runs/'p1.sol')}
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--baseline',type=Path,required=True)
+    parser.add_argument('--candidate',type=Path,required=True)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--zepol',type=Path,required=True)
+    args=parser.parse_args()
+    args.output.mkdir(parents=True,exist_ok=False)
+    def soil(depths):return '7778\nEvaluation\n1 0\n'+probe.soil_body(depths)
+    cases={'original_fixture':None,'two':soil([200,1600]),
+           'nine':soil([200+175*i for i in range(9)]),
+           'ten':soil([200+1400*i/9 for i in range(10)]),
+           'eleven':soil([200,300,400,500,600,700,800,900,1000,1100,1600]),
+           'zepol':normalize_zepol(args.zepol),
+           'ten_low_k':'7778\nEvaluation\n1 0\n'+probe.soil_body([200+1400*i/9 for i in range(10)],conductivity=[.036]*10),
+           'eleven_low_k':'7778\nEvaluation\n1 0\n'+probe.soil_body([200,300,400,500,600,700,800,900,1000,1100,1600],conductivity=[.036]*11)}
+    report={'binaries':{'baseline':digest(args.baseline),'candidate':digest(args.candidate)},'cases':{}}
+    for name,soil_text in cases.items():
+        results={label:run(binary.resolve(),args.output/name/label,soil_text) for label,binary in [('baseline',args.baseline),('candidate',args.candidate)]}
+        results['byte_identical_outputs']=results['baseline']['artifacts']==results['candidate']['artifacts']
+        report['cases'][name]=results
+        print(name, {k:v['success'] for k,v in results.items() if isinstance(v,dict)}, 'identical',results['byte_identical_outputs'],flush=True)
+    (args.output/'report.json').write_text(json.dumps(report,indent=2)+'\n')
+    if not all(v[label]['success'] for v in report['cases'].values() for label in ('baseline','candidate')):raise SystemExit(1)
+    if not all(report['cases'][name]['byte_identical_outputs'] for name in ('original_fixture','two','nine','ten','ten_low_k')):raise SystemExit(2)
+
+
+if __name__=='__main__':main()
