index 000000000..5fc5d5c6b
--- /dev/null
+++ b/wepppy/rq/_query_catalog_admission.py
@@ -0,0 +1,273 @@
+"""One Redis admission ledger for every catalog job on shared batch."""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+import json
+import time
+from typing import Any
+
+from redis.exceptions import WatchError
+from rq import Queue, worker_registration
+from rq.job import Job
+from rq.suspension import WORKERS_SUSPENDED
+
+LEDGER_KEY = 'query-catalog:batch-admission:v1'
+PAUSE_KEY = LEDGER_KEY + ':paused'
+TERMINAL = frozenset({'finished', 'failed', 'stopped', 'canceled'})
+CAP = 7
+
+
+class AdmissionDenied(RuntimeError):
+    pass
+
+
+def _text(value):
+    return value.decode() if isinstance(value, bytes) else value
+
+
+def _ledger(connection):
+    raw = connection.get(LEDGER_KEY)
+    if raw is None:
+        raise AdmissionDenied('query_catalog_accounting_unavailable')
+    data = json.loads(raw)
+    if not isinstance(data, dict) or not isinstance(data.get('jobs'), dict):
+        raise AdmissionDenied('query_catalog_accounting_invalid')
+    for jid, binding in data['jobs'].items():
+        if (not isinstance(jid, str) or not isinstance(binding, dict)
+                or binding.get('kind') not in {'refresh', 'inventory'}
+                or not isinstance(binding.get('configuration'), dict)
+                or type(binding.get('claimed')) is not bool
+                or not isinstance(binding.get('reserved_at'), (int, float))):
+            raise AdmissionDenied('query_catalog_accounting_invalid')
+    return data
+
+
+def execution_uncertain(binding: dict[str, Any], status: str | None) -> bool:
+    # RQ cancel() can mark STARTED work canceled without stopping its workhorse.
+    # Real finished/failed/stopped transitions retain RQ's death/timeout semantics.
+    return status is None or (status == 'canceled' and binding['claimed']
+                              and not binding.get('execution_exited_at'))
+
+
+def execution_outstanding(binding: dict[str, Any], status: str | None) -> bool:
+    return status not in TERMINAL or execution_uncertain(binding, status)
+
+
+def initialize_admission(connection: Any, queue: Queue) -> None:
+    """Explicit operator bootstrap; never reset an existing or uncertain ledger."""
+    if queue.name != 'batch':
+        raise ValueError('Catalog admission requires shared batch')
+    with connection.pipeline() as pipe:
+        keys = [queue.key] + ['rq:' + name + ':batch' for name in ('wip', 'deferred', 'scheduled')]
+        pipe.watch(LEDGER_KEY, *keys)
+        if pipe.exists(LEDGER_KEY):
+            _ledger(pipe)
+            return
+        if next(connection.scan_iter('query-catalog:pilot:*'), None) is not None:
+            raise AdmissionDenied('Lost ledger requires explicit operator recovery')
+        identifiers = list(pipe.lrange(queue.key, 0, -1))
+        for registry in keys[1:]:
+            identifiers.extend(pipe.zrange(registry, 0, -1))
+        if any((_text(jid) or '').startswith('query_catalog_refresh_') for jid in identifiers):
+            raise AdmissionDenied('Existing maintenance requires explicit ledger recovery')
+        pipe.multi()
+        pipe.set(LEDGER_KEY, json.dumps({'jobs': {}, 'initialized_at': time.time()}))
+        pipe.execute()
+
+
+def ordinary_observation(connection: Any, queue: Queue, ledger: dict[str, Any]) -> dict[str, Any]:
+    waiting = []
+    oldest = 0.0
+    unknown = False
+    for raw in connection.lrange(queue.key, 0, -1):
+        jid = _text(raw)
+        if jid in ledger['jobs']:
+            continue
+        waiting.append(jid)
+        value = connection.hget(Job.key_for(jid), 'enqueued_at')
+        try:
+            timestamp = datetime.fromisoformat(_text(value).replace('Z', '+00:00'))
+            if timestamp.tzinfo is None:
+                timestamp = timestamp.replace(tzinfo=timezone.utc)
+            oldest = max(oldest, time.time() - timestamp.timestamp())
+        except (AttributeError, TypeError, ValueError):
+            unknown = True
+    return dict(ordinary_waiting=len(waiting), oldest_wait_seconds=oldest,
+                unknown_wait_metadata=unknown)
+
+
+def _deny(queue, pilot_id, reason):
+    if pilot_id:
+        from ._query_catalog_pilot import pause_pilot
+        pause_pilot(queue.connection, pilot_id, reason)
+    raise AdmissionDenied(reason)
+
+
+def prepare(pipe: Any, queue: Queue, *, job_id: str, kind: str, configuration: dict[str, Any],
+            scope: dict[str, Any] | None = None, pilot_id: str | None = None,
+            controller_token: str | None = None) -> dict[str, Any]:
+    """Read all policy inputs under WATCH; caller enqueues and commits ticket."""
+    from . import _query_catalog_pilot as pilot
+    from .query_catalog_rq import WORKER_FIELD
+    if queue.name != 'batch' or kind not in {'refresh', 'inventory'}:
+        raise AdmissionDenied('query_catalog_queue_invalid')
+    pipe.watch(LEDGER_KEY, PAUSE_KEY, queue.key, WORKERS_SUSPENDED)
+    try:
+        ledger = _ledger(pipe)
+    except (AdmissionDenied, ValueError):
+        _deny(queue, pilot_id, 'accounting_failure')
+    if pipe.exists(PAUSE_KEY) or pipe.exists(WORKERS_SUSPENDED):
+        _deny(queue, pilot_id, 'query_catalog_admission_paused')
+    if len(ledger['jobs']) > CAP:
+        _deny(queue, pilot_id, 'query_catalog_accounting_invalid')
+    remaining = {}
+    for jid, binding in ledger['jobs'].items():
+        pipe.watch(Job.key_for(jid))
+        status = _text(pipe.hget(Job.key_for(jid), 'status'))
+        if execution_uncertain(binding, status):
+            _deny(queue, pilot_id, 'query_catalog_accounting_uncertain')
+        if execution_outstanding(binding, status):
+            remaining[jid] = binding
+    # Queue classification uses ledger ownership; unknown prefix-shaped jobs are
+    # ordinary/uncertain work, never authority to bypass backlog priority.
+    queued = [_text(jid) for jid in pipe.lrange(queue.key, 0, -1)]
+    if len(queued) != len(set(queued)):
+        _deny(queue, pilot_id, 'accounting_failure')
+    if any(jid not in ledger['jobs'] for jid in queued):
+        _deny(queue, pilot_id, 'query_catalog_ordinary_backlog')
+    if any(_text(pipe.hget(Job.key_for(jid), 'status')) != 'queued' for jid in queued):
+        _deny(queue, pilot_id, 'accounting_failure')
+    pipe.watch('rq:workers', 'rq:workers:batch')
+    registrations = list(worker_registration.get_keys(queue=queue))
+    compatible = 0
+    for registration in registrations:
+        pipe.watch(registration)
+        queues, advertised, death = pipe.hmget(registration, 'queues', WORKER_FIELD, 'death')
+        if death is not None or pipe.ttl(registration) <= 0 or 'batch' not in (_text(queues) or '').split(','):
+            continue
+        try:
+            observed = json.loads(advertised) if advertised else None
+        except (ValueError, TypeError):
+            observed = None
+        if observed != configuration:
+            _deny(queue, pilot_id, 'query_catalog_workers_unavailable')
+        compatible += 1
+    if pilot_id and compatible != 8:
+        _deny(queue, pilot_id, 'configuration_mismatch')
+    if not compatible:
+        _deny(queue, pilot_id, 'query_catalog_workers_unavailable')
+    if len(remaining) >= min(CAP, compatible):
+        raise AdmissionDenied('query_catalog_capacity_pending')
+    pilot_data = None
+    if pilot_id:
+        pipe.watch(pilot.key(pilot_id), pilot.key(pilot_id) + ':observer')
+        pilot_data = pilot.read(pipe, pilot_id)
+        try:
+            pilot.require_admission(pipe, pilot_data, controller_token)
+        except RuntimeError:
+            _deny(queue, pilot_id, 'query_catalog_pilot_authority_unavailable')
+        if pilot_data['counters'][kind] >= pilot.BUDGETS[kind]:
+            raise AdmissionDenied('query_catalog_pilot_budget_exhausted')
+        if kind == 'refresh':
+            approved = pilot._scope(pilot_data['manifest'], scope['wd'])
+            if approved['scope_id'] != scope['scope_id'] or approved['incarnation'] != scope['incarnation']:
+                raise AdmissionDenied('query_catalog_pilot_scope_invalid')
+    elif not configuration['enabled']:
+        raise AdmissionDenied('query_catalog_refresh_disabled')
+    binding = dict(kind=kind, pilot_id=pilot_id, configuration=configuration,
+                   scope=scope, claimed=False, reserved_at=time.time())
+    if pilot_data:
+        binding['generation'] = pilot_data['manifest']['generation']
+        pilot_data['counters'][kind] += 1
+        pilot_data['jobs'][job_id] = binding
+    remaining[job_id] = binding
+    ledger['jobs'] = remaining
+    return dict(ledger=ledger, pilot=pilot_data, pilot_id=pilot_id)
+
+
+def commit(pipe: Any, ticket: dict[str, Any]) -> None:
+    """Append policy writes to the caller's existing RQ enqueue transaction."""
+    from . import _query_catalog_pilot as pilot
+    pipe.set(LEDGER_KEY, json.dumps(ticket['ledger']))
+    if ticket['pilot'] is not None:
+        pipe.set(pilot.key(ticket['pilot_id']), json.dumps(ticket['pilot']))
+
+
+def _authorize_job_once(connection: Any, job: Job, *, kind: str, pilot_id: str | None,
+                  scope_id: str | None = None, wd: str | None = None) -> dict[str, Any] | None:
+    from . import _query_catalog_pilot as pilot
+    from .query_catalog_rq import catalog_worker_configuration
+    with connection.pipeline() as pipe:
+        pipe.watch(LEDGER_KEY, Job.key_for(job.id))
+        ledger = _ledger(pipe)
+        binding = ledger['jobs'].get(job.id)
+        if (not binding or binding['kind'] != kind or binding.get('pilot_id') != pilot_id or
+                binding['configuration'] != catalog_worker_configuration() or binding.get('claimed')):
+            raise ValueError('Catalog job has no unused admitted execution authority')
+        if job.origin != 'batch' or _text(pipe.hget(Job.key_for(job.id), 'status')) != 'started':
+            raise ValueError('Catalog job is not started')
+        if kind == 'refresh' and (binding['scope']['scope_id'] != scope_id or binding['scope']['wd'] != str(wd)):
+            raise ValueError('Catalog scope argument changed')
+        data = None
+        if pilot_id:
+            pipe.watch(pilot.key(pilot_id))
+            data = pilot.read(pipe, pilot_id)
+            approved = data['jobs'].get(job.id)
+            if approved != binding or data['manifest']['generation'] != binding['generation']:
+                raise ValueError('Pilot job binding changed')
+            if kind == 'refresh':
+                if binding['scope']['scope_id'] != scope_id:
+                    raise ValueError('Pilot scope argument changed')
+                pilot._scope(data['manifest'], binding['scope']['wd'])
+        binding['claimed'] = True
+        binding['claimed_at'] = time.time()
+        pipe.multi()
+        pipe.set(LEDGER_KEY, json.dumps(ledger))
+        if data:
+            data['jobs'][job.id] = binding
+            pipe.set(pilot.key(pilot_id), json.dumps(data))
+        pipe.execute()
+    return data['manifest'] if data else None
+
+
+def authorize_job(connection: Any, job: Job, *, kind: str, pilot_id: str | None,
+                  scope_id: str | None = None, wd: str | None = None) -> dict[str, Any] | None:
+    # Up to seven workers claim concurrently against the shared ledger. A CAS
+    # retry rereads all authority; it never replays a committed execution claim.
+    for attempt in range(16):
+        try:
+            return _authorize_job_once(connection, job, kind=kind, pilot_id=pilot_id,
+                                       scope_id=scope_id, wd=wd)
+        except WatchError:
+            if attempt == 15:
+                raise
+
+
+def execution_exited(connection: Any, job: Job, pilot_id: str | None) -> None:
+    """Durable proof that admitted scope work has left its worker boundary."""
+    from . import _query_catalog_pilot as pilot
+    for attempt in range(16):
+        try:
+            with connection.pipeline() as pipe:
+                pipe.watch(LEDGER_KEY)
+                ledger = _ledger(pipe)
+                binding = ledger['jobs'].get(job.id)
+                if not binding or not binding['claimed'] or binding.get('pilot_id') != pilot_id:
+                    raise ValueError('Execution exit has no admitted claim')
+                data = None
+                if pilot_id:
+                    pipe.watch(pilot.key(pilot_id))
+                    data = pilot.read(pipe, pilot_id)
+                    if data['jobs'].get(job.id) != binding:
+                        raise ValueError('Execution exit binding changed')
+                binding['execution_exited_at'] = time.time()
+                pipe.multi()
+                pipe.set(LEDGER_KEY, json.dumps(ledger))
+                if data is not None:
+                    data['jobs'][job.id] = binding
+                    pipe.set(pilot.key(pilot_id), json.dumps(data))
+                pipe.execute()
+            return
+        except WatchError:
+            if attempt == 15:
+                raise
diff --git a/wepppy/rq/_query_catalog_inventory.py b/wepppy/rq/_query_catalog_inventory.py
new file mode 100644
index 000000000..95a8e7be6
--- /dev/null
+++ b/wepppy/rq/_query_catalog_inventory.py
@@ -0,0 +1,264 @@
+"""Replayable directory streaming; Redis state is coordination, never provenance."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import stat
+import time
+from typing import Any
+
+from redis.exceptions import WatchError
+
+
+class InventorySuperseded(RuntimeError):
+    """A replaced inventory attempt cannot publish progress."""
+
+
+class InventoryScopeMissing(FileNotFoundError):
+    """A discovered child disappeared while its required root remains present."""
+
+
+def validated_scope_path(roots: list[Any], value: str) -> Path:
+    """Map a Redis locator lexically before any resolving/project-writing API."""
+    if not isinstance(value, str):
+        raise ValueError('Malformed inventory scope path')
+    path = Path(value)
+    if not path.is_absolute() or '..' in path.parts:
+        raise ValueError('Inventory scope must be inside a configured root')
+    matches = []
+    for index, root in enumerate(roots):
+        try:
+            relative = path.relative_to(root.path)
+        except ValueError:
+            continue
+        matches.append((len(Path(root.path).parts), index, relative))
+    if not matches:
+        raise ValueError('Inventory scope is outside configured roots')
+    _, index, relative = max(matches)
+    try:
+        return _validated_scope_relative(roots, index, relative)
+    except InventoryScopeMissing:
+        raise
+    except FileNotFoundError:
+        # Only explicitly configured namespace/layout aliases may replace a
+        # missing root spelling. Never redirect a symlink or missing child.
+        missing_child = None
+        for alias_index, alias in enumerate(roots):
+            if (alias_index == index or alias.namespace != roots[index].namespace or
+                    alias.layout != roots[index].layout):
+                continue
+            try:
+                return _validated_scope_relative(roots, alias_index, relative)
+            except InventoryScopeMissing as exc:
+                missing_child = exc
+            except FileNotFoundError:
+                continue
+        if missing_child is not None:
+            raise missing_child
+        raise
+
+
+def _validated_scope_relative(roots: list[Any], index: int, relative: Path) -> Path:
+    root = Path(roots[index].path)
+    # A missing required root remains an error, never a deleted-child success.
+    validated_path(roots, {'root': index, 'relative': '.'})
+    _identity(root)
+    try:
+        result = validated_path(roots, {'root': index, 'relative': str(relative)})
+        _identity(result)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        validated_path(roots, {'root': index, 'relative': '.'})
+        _identity(root)
+        if relative == Path('.'):
+            raise
+        raise InventoryScopeMissing('Discovered scope is no longer a directory') from exc
+    return result
+
+
+def state(connection: Any, key: str) -> dict[str, Any]:
+    raw = connection.get(key + ':discovery')
+    return json.loads(raw) if raw else {}
+
+
+def initialize(pipeline: Any, key: str, cycle: str, roots: list[Any], *, seeds: list[dict[str, Any]] | None = None) -> None:
+    pipeline.delete(*(key + suffix for suffix in (':frontier', ':seen', ':scopes', ':stream')))
+    pipeline.set(key + ':discovery', json.dumps({
+        'cycle': cycle, 'job_id': None, 'started_at': time.time(), 'visited': 0,
+        'entries': 0, 'errors': [],
+    }))
+    frontier = seeds if seeds is not None else [{'root': i, 'relative': '.'} for i in range(len(roots))]
+    if frontier:
+        pipeline.rpush(key + ':frontier', *(json.dumps(item) for item in frontier))
+
+
+def validated_path(roots: list[Any], item: dict[str, Any]) -> Path:
+    index = item.get('root')
+    relative = item.get('relative')
+    if type(index) is not int or not 0 <= index < len(roots) or not isinstance(relative, str):
+        raise ValueError('Malformed inventory frontier')
+    rel = Path(relative)
+    if rel.is_absolute() or '..' in rel.parts:
+        raise ValueError('Inventory path escapes configured root')
+    root = Path(roots[index].path)
+    path = root
+    # Check each component, including intermediate scenario containers.
+    for component in (None, *rel.parts):
+        if component is not None:
+            path = path / component
+        if stat.S_ISLNK(path.lstat().st_mode):
+            raise ValueError('Inventory symlink is not traversable')
+    path.resolve().relative_to(root.resolve())
+    return path
+
+
+def _identity(path: Path) -> list[int]:
+    info = path.stat()
+    if not stat.S_ISDIR(info.st_mode):
+        raise NotADirectoryError(str(path))
+    return [info.st_dev, info.st_ino]
+
+
+def checkpoint(connection: Any, key: str, job_id: str, cycle: str, *,
+               children: list[dict[str, Any]] = (), scope: str | None = None,
+               identity: list[int] | None = None, exhausted: bool = False,
+               entries: int = 0, error: str | None = None) -> None:
+    """Fence dedup, frontier, discoveries and completion in one transaction."""
+    with connection.pipeline() as pipe:
+        pipe.watch(key + ':discovery', key + ':generation')
+        current = state(pipe, key)
+        if current.get('job_id') != job_id or current.get('cycle') != cycle:
+            raise InventorySuperseded('Inventory attempt was replaced')
+        reset = identity is not None and current.get('directory_identity') != identity
+        fresh = []
+        for child in children:
+            encoded = json.dumps(child, sort_keys=True)
+            if reset or not pipe.sismember(key + ':seen', encoded):
+                fresh.append(encoded)
+        publish_scope = scope is not None and not pipe.sismember(key + ':scopes', scope)
+        current['entries'] = current.get('entries', 0) + entries
+        current['updated_at'] = time.time()
+        current['errors'] = [error] if error else []
+        if identity is not None:
+            current['directory_identity'] = identity
+        if exhausted:
+            current['visited'] = current.get('visited', 0) + 1
+            current.pop('directory_identity', None)
+        pipe.multi()
+        if reset:
+            pipe.delete(key + ':seen')
+        if fresh:
+            pipe.sadd(key + ':seen', *fresh)
+            pipe.rpush(key + ':frontier', *fresh)
+        if publish_scope:
+            pipe.sadd(key + ':scopes', scope)
+            pipe.xadd(key + ':stream', {'path': scope})
+        if exhausted:
+            pipe.lpop(key + ':frontier')
+            pipe.delete(key + ':seen')
+        pipe.set(key + ':discovery', json.dumps(current))
+        try:
+            pipe.execute()
+        except WatchError as exc:
+            raise InventorySuperseded('Inventory checkpoint ownership changed') from exc
+
+
+def _complete(connection: Any, key: str, job_id: str, cycle: str) -> None:
+    with connection.pipeline() as pipe:
+        pipe.watch(key + ':discovery', key + ':frontier', key + ':generation')
+        current = state(pipe, key)
+        if current.get('job_id') != job_id or current.get('cycle') != cycle:
+            raise InventorySuperseded('Inventory completion ownership changed')
+        if pipe.llen(key + ':frontier') or current.get('errors'):
+            raise RuntimeError('Incomplete inventory cannot complete')
+        current['completed_at'] = time.time()
+        pipe.multi()
+        pipe.set(key + ':discovery', json.dumps(current))
+        try:
+            pipe.execute()
+        except WatchError as exc:
+            raise InventorySuperseded('Inventory completion ownership changed') from exc
+
+
+def run(connection: Any, key: str, job_id: str, cycle: str, roots: list[Any], limit: int, *, approved_paths: set[str] | None = None, validate_scope: Any = None) -> None:
+    """Stream to exhaustion; restart replays only the current directory prefix.
+
+    Each publication contains at most ``limit`` entry records. RQ supplies the
+    overall execution deadline; slow directory I/O never holds a scheduler lock.
+    """
+    while True:
+        current = state(connection, key)
+        if current.get('job_id') != job_id or current.get('cycle') != cycle:
+            raise InventorySuperseded('Inventory attempt was replaced')
+        raw = connection.lindex(key + ':frontier', 0)
+        if raw is None:
+            _complete(connection, key, job_id, cycle)
+            return
+        item = json.loads(raw)
+        try:
+            path = validated_path(roots, item)
+            if approved_paths is not None:
+                if str(path) not in approved_paths:
+                    raise ValueError('Inventory scope is outside pilot manifest')
+                validate_scope(path)
+            identity = _identity(path)
+            checkpoint(connection, key, job_id, cycle, identity=identity)
+            project = any((path / marker).is_file() for marker in ('ron.nodb', 'wepp.nodb', '_query_engine/catalog.json'))
+            children = []
+            if approved_paths is not None:
+                if not project:
+                    raise ValueError('Approved pilot project marker missing')
+                validate_scope(path)
+                checkpoint(connection, key, job_id, cycle, scope=str(path), exhausted=True)
+                continue
+            if project:
+                for name in ('_pups', 'rhessys/scenarios', 'runs', '_base'):
+                    child = path / name
+                    try:
+                        info = child.lstat()
+                    except FileNotFoundError:
+                        continue
+                    if stat.S_ISDIR(info.st_mode):
+                        children.append({'root': item['root'], 'relative': str(child.relative_to(roots[item['root']].path))})
+                validated_path(roots, item)
+                if _identity(path) != identity:
+                    raise RuntimeError('Inventory directory replaced during discovery')
+                for offset in range(0, len(children), limit):
+                    checkpoint(connection, key, job_id, cycle, children=children[offset:offset + limit])
+                checkpoint(connection, key, job_id, cycle, scope=str(path), exhausted=True)
+                continue
+            count = 0
+            with os.scandir(path) as stream:
+                for entry in stream:
+                    count += 1
+                    if entry.is_dir(follow_symlinks=False):
+                        children.append({'root': item['root'], 'relative': str(Path(entry.path).relative_to(roots[item['root']].path))})
+                    if count >= limit:
+                        validated_path(roots, item)
+                        if _identity(path) != identity:
+                            raise RuntimeError('Inventory directory replaced during streaming')
+                        checkpoint(connection, key, job_id, cycle, children=children, entries=count)
+                        children, count = [], 0
+            validated_path(roots, item)
+            if _identity(path) != identity:
+                raise RuntimeError('Inventory directory replaced during streaming')
+            checkpoint(connection, key, job_id, cycle, children=children, entries=count, exhausted=True)
+        except FileNotFoundError:
+            # Removed children are no longer scopes. A required missing root is
+            # degraded unless another configured alias covers its namespace.
+            if item.get('relative') != '.':
+                checkpoint(connection, key, job_id, cycle, exhausted=True)
+                continue
+            namespace = roots[item['root']].namespace
+            aliases = [root for i, root in enumerate(roots) if i != item['root'] and root.namespace == namespace]
+            if any(Path(root.path).is_dir() and os.access(root.path, os.R_OK | os.X_OK) for root in aliases):
+                checkpoint(connection, key, job_id, cycle, exhausted=True)
+                continue
+            checkpoint(connection, key, job_id, cycle, error='FileNotFoundError')
+            raise
+        except InventorySuperseded:
+            raise
+        except (OSError, ValueError, RuntimeError) as exc:
+            # Worker boundary retains incomplete frontier for retry; no project writes.
+            checkpoint(connection, key, job_id, cycle, error=type(exc).__name__)
+            raise
