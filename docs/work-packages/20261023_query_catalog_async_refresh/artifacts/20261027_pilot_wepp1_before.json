    {
      "id": "6629fec3e33663ab9833293c4c05cb5211ea4f3f59f756530189a18db1bea52e",
      "name": "/docker-postgres-backup-1",
      "image": "sha256:c482971e06a84ca61d677321488dee4034e8979c6311d72f065be07f4e886760",
      "service": "postgres-backup",
      "started_at": "2026-10-26T10:44:29.906656019Z",
      "user": "",
      "group_add": null,
      "command": [
        "bash",
        "-lc",
        "set -euo pipefail\nmkdir -p \"${BACKUP_DIR:-/backups}\"\n\nif [ ! -f /run/secrets/postgres_password ]; then\n  echo \"[postgres-backup] Missing /run/secrets/postgres_password\" >&2\n  exit 1\nfi\n\npassword=\"$(cat /run/secrets/postgres_password)\"\nif [ -z \"$password\" ]; then\n  echo \"[postgres-backup] /run/secrets/postgres_password is empty\" >&2\n  exit 1\nfi\n\npgpass_file=\"/tmp/.pgpass\"\numask 077\nprintf \"%s:%s:%s:%s:%s\\\\n\" \"${PGHOST}\" \"${PGPORT:-5432}\" \"${PGDATABASE}\" \"${PGUSER}\" \"$password\" > \"$pgpass_file\"\nexport PGPASSFILE=\"$pgpass_file\"\n\n# Run initial backup on startup\nrun_backup() {\n  ts=$(date +\"%Y%m%d-%H%M%S\")\n  target=\"${BACKUP_DIR:-/backups}/weppcloud-${ts}.dump\"\n  tmp_target=\"${target}.tmp\"\n\n  echo \"[ $(date --iso-8601=seconds) ] Starting backup to $target\"\n\n  # Dump to temp file first, then atomic rename\n  if pg_dump -h \"${PGHOST}\" -U \"${PGUSER}\" -d \"${PGDATABASE}\" -Fc -f \"$tmp_target\"; then\n    mv \"$tmp_target\" \"$target\"\n\n    # Verify backup header\n    if head -c 5 \"$target\" | grep -q \"PGDMP\"; then\n      size=$(du -h \"$target\" | cut -f1)\n      echo \"[ $(date --iso-8601=seconds) ] Backup complete: $target ($size)\"\n    else\n      echo \"[ $(date --iso-8601=seconds) ] ERROR: Backup verification failed - invalid header\"\n      rm -f \"$target\"\n      return 1\n    fi\n  else\n    echo \"[ $(date --iso-8601=seconds) ] ERROR: pg_dump failed\"\n    rm -f \"$tmp_target\"\n    return 1\n  fi\n\n  # Purge old backups\n  echo \"[ $(date --iso-8601=seconds) ] Purging backups older than ${BACKUP_KEEP_DAYS:-7} days\"\n  find \"${BACKUP_DIR:-/backups}\" -name \"weppcloud-*.dump\" -type f -mtime +${BACKUP_KEEP_DAYS:-7} -delete\n\n  # Also purge legacy named backups\n  find \"${BACKUP_DIR:-/backups}\" -name \"wepppy-*.dump\" -type f -mtime +${BACKUP_KEEP_DAYS:-7} -delete\n\n  # List current backups\n  echo \"[ $(date --iso-8601=seconds) ] Current backups:\"\n  ls -lh \"${BACKUP_DIR:-/backups}\"/*.dump 2>/dev/null || echo \"  (none)\"\n}\n\n# Initial backup\nrun_backup || echo \"Initial backup failed, will retry on schedule\"\n\n# Scheduled backups\nwhile true; do\n  sleep ${BACKUP_INTERVAL_SECONDS:-86400}\n  run_backup || echo \"Scheduled backup failed\"\ndone\n"
      ],
      "entrypoint": [
        "docker-entrypoint.sh"
      ],
      "mounts": [
        {
          "Type": "volume",
          "Source": "/var/lib/docker/volumes/docker_postgres-backups/_data",
          "Destination": "/backups",
          "RW": true
        },
        {
          "Type": "volume",
          "Source": "/var/lib/docker/volumes/97d6f67fac10cd4b80fa53e3e113028533b0ce0fc8c71c60ec46d4e32a5de418/_data",
          "Destination": "/var/lib/postgresql/data",
          "RW": true
        },
        {
          "Type": "bind",
          "Source": "/workdir/wepppy/docker/secrets/postgres_password",
          "Destination": "/run/secrets/postgres_password",
          "RW": false
        }
      ]
    },
