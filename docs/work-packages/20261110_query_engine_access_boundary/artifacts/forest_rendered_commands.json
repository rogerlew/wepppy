{
  "weppcloud": {
    "command": [
      "gunicorn",
      "--limit-request-line",
      "8190",
      "--workers",
      "4",
      "--threads",
      "2",
      "--timeout",
      "1800",
      "--bind",
      "0.0.0.0:8000",
      "--log-level",
      "info",
      "--forwarded-allow-ips",
      "192.168.1.1",
      "--max-requests",
      "1000",
      "--max-requests-jitter",
      "200",
      "wepppy.weppcloud.app:app"
    ],
    "user": "1000:993",
    "origins": null
  },
  "query-engine": {
    "command": [
      "uvicorn",
      "--h11-max-incomplete-event-size",
      "131072",
      "wepppy.query_engine.app.server:create_app",
      "--factory",
      "--host",
      "0.0.0.0",
      "--port",
      "8041"
    ],
    "user": "1000:993",
    "origins": "https://forest.tail305ec9.ts.net"
  }
}
