{
  "$id": "https://github.com/rogerlew/wepppy/peakflow-phase1/schemas/event-packet.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "post_surplus_forcing": {
      "items": {
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "pre_surplus_forcing": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "production": {
      "additionalProperties": false,
      "properties": {
        "peak_m_s": {
          "minimum": 0,
          "type": "number"
        },
        "selected_solver": {
          "enum": [
            "APPMTH",
            "HDRIVE"
          ]
        }
      },
      "required": [
        "selected_solver",
        "peak_m_s"
      ],
      "type": "object"
    },
    "scalars": {
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      },
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_build_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source_build_id",
    "payload_sha256",
    "scalars",
    "post_surplus_forcing",
    "production"
  ],
  "title": "Event Packet",
  "type": "object"
}
