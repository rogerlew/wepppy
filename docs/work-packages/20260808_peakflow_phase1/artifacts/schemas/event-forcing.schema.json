{
  "$id": "https://github.com/rogerlew/wepppy/peakflow-phase1/schemas/event-forcing.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "end_s": {
      "minimum": 0,
      "type": "number"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "interval_ordinal": {
      "minimum": 1,
      "type": "integer"
    },
    "rate_mm_h": {
      "minimum": 0,
      "type": "number"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "pre_surplus",
        "post_surplus",
        "hourly_surface_return"
      ]
    },
    "start_s": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "stage",
    "interval_ordinal",
    "start_s",
    "end_s",
    "rate_mm_h"
  ],
  "title": "Event Forcing",
  "type": "object"
}
