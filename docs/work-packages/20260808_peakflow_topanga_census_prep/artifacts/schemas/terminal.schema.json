{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "changed_inputs": {"items": {"type": "string"}, "type": "array"},
    "error": {"type": "string"},
    "error_type": {"type": "string"},
    "executable_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "hbp": {"type": ["string", "null"]},
    "hbp_sha256": {"type": ["string", "null"]},
    "input_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "mutation": {"type": "object"},
    "plan_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "returncode": {"type": "integer"},
    "runtime_s": {"minimum": 0, "type": "number"},
    "schema_hash": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["complete", "failed", "stopped"]},
    "terminal_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "trace": {"type": ["string", "null"]},
    "trace_sha256": {"type": ["string", "null"]},
    "trial_id": {"type": "string"}
  },
  "required": ["schema_version", "schema_hash", "plan_id", "trial_id", "input_sha256", "executable_sha256", "terminal_id", "status", "runtime_s"],
  "type": "object"
}
