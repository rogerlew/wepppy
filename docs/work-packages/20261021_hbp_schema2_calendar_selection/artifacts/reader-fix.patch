+  integer function find_requested_day(calendar_year, julian_day) result(day_index)
+    integer, intent(in) :: calendar_year, julian_day
+    integer :: low, high, middle, sim_year
+
+    day_index = 0
+    if (calendar_year < reader%iwsbyr .or. calendar_year > reader%iwsbyr + reader%maxyrs - 1) return
+    sim_year = calendar_year - reader%iwsbyr + 1
+    low = 1
+    high = reader%logical_day_count
+    ! Directory validation guarantees ordered (simulation year, Julian day) keys.
+    ! Lookup leaves schema-2 padding in storage without consuming it as a routing day.
+    do while (low <= high)
+      middle = low + (high - low) / 2
+      if (reader%day_sim_year_index(middle) < sim_year) then
+        low = middle + 1
+      else if (reader%day_sim_year_index(middle) > sim_year) then
+        high = middle - 1
+      else if (reader%day_julian_day(middle) < julian_day) then
+        low = middle + 1
+      else if (reader%day_julian_day(middle) > julian_day) then
+        high = middle - 1
+      else
+        if (reader%day_calendar_year(middle) == calendar_year) day_index = middle
+        return
+      end if
+    end do
+  end function find_requested_day
+
