+    real :: tile_depth(1), tile(1), peak(1), detachment(1), deposition(1), baseflow(1), seepage(1)
+    real :: sediment(5,1), fractions(5,1), expected
+
+    ! Generate serialized records with distinct day/year signatures in volume and sediment fields.
+    ! Middle year is 2004 (leap) or 1900 (existing legacy-centurial day 366).
+    shard = make_dense_shard(first_year, 1, major, 0)
+    shard%nyear = 3
+    deallocate(shard%years, shard%records)
+    allocate(shard%years(3))
+    total = 1096
+    if (major == 2) total = 1098
+    allocate(shard%records(total))
+    n = 0
+    do y = first_year, first_year+2
+      days = 365
+      if (y == first_year+1 .or. major == 2) days = 366
+      shard%years(y-first_year+1) = hbp_year_entry(y-first_year+1, y, days, 1, days, 0)
+      do d = 1, days
+        n = n + 1
+        shard%records(n) = make_dense_record(y, 120, 5, 2, 3)
+        if (d == 366 .and. y /= first_year+1) shard%records(n) = make_dense_record(y, 366, 5, 2, 3)
+        shard%records(n)%sim_year_index = y - first_year + 1
+        shard%records(n)%julian_day = d
+        expected = real((y-first_year+1)*1000+d)
+        shard%records(n)%baseflow_volume_m3 = real(expected+3, real64)
+        shard%records(n)%dissolved_storage_volume_m3 = real(expected+4, real64)
+        if (d == 366 .and. y /= first_year+1) cycle
+        shard%records(n)%runoff_volume_m3 = real(expected, real64)
+        shard%records(n)%subsurface_flow_volume_m3 = real(expected+1, real64)
+        shard%records(n)%tile_drainage_volume_m3 = real(expected+2, real64)
